{
  "name": "@dennykuo/glass-toast",
  "version": "0.1.2",
  "description": "Zero-dependency glassmorphism toast notifications — vanilla JS, framework-free, Tailwind-free. 毛玻璃質感 toast 通知，零相依開箱即用。",
  "type": "module",
  "license": "MIT",
  "author": "Denny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennykuo/glass-toast.git"
  },
  "homepage": "https://dennykuo.github.io/glass-toast/",
  "bugs": {
    "url": "https://github.com/dennykuo/glass-toast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toast",
    "notification",
    "snackbar",
    "vanilla-js",
    "glassmorphism",
    "zero-dependency"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/auto.js",
    "./src/auto.js",
    "./docs/**"
  ],
  "main": "./dist/glass-toast.umd.cjs",
  "module": "./dist/glass-toast.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/glass-toast.umd.js",
  "jsdelivr": "./dist/glass-toast.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/glass-toast.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/glass-toast.umd.cjs"
      }
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "default": "./dist/auto.js"
    },
    "./style.css": {
      "types": "./dist/glass-toast.css.d.ts",
      "default": "./dist/glass-toast.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite docs",
    "build:docs": "vite build docs",
    "build": "vite build && vite build --mode umd && node scripts/build-cdn.mjs && node scripts/build-css.mjs && tsc -p tsconfig.json && node scripts/build-cts.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:watch": "vitest",
    "lint": "eslint src test scripts docs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "publint": "^0.3.25",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
