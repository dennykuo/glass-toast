{
  "name": "@dennykuo/glass-toast",
  "version": "0.1.0",
  "description": "Zero-dependency glassmorphism toast notifications — vanilla JS, framework-free, Tailwind-free. 毛玻璃質感 toast 通知，零相依開箱即用。",
  "type": "module",
  "license": "MIT",
  "author": "Denny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennykuo/glass-toast.git"
  },
  "homepage": "https://github.com/dennykuo/glass-toast#readme",
  "bugs": {
    "url": "https://github.com/dennykuo/glass-toast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toast",
    "notification",
    "snackbar",
    "vanilla-js",
    "glassmorphism",
    "zero-dependency"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/auto.js",
    "./src/auto.js"
  ],
  "main": "./dist/glass-toast.umd.cjs",
  "module": "./dist/glass-toast.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/glass-toast.umd.cjs",
  "jsdelivr": "./dist/glass-toast.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glass-toast.js",
      "require": "./dist/glass-toast.umd.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "default": "./dist/auto.js"
    },
    "./style.css": "./dist/glass-toast.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && vite build --mode umd && node scripts/build-css.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
